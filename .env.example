# Server-only. Never prefix with NEXT_PUBLIC_/VITE_ — this must not reach the browser bundle.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b (with openai/gpt-oss-20b as automatic fallback) if unset.
# Leave blank unless you want to pin one specific model. Old Llama IDs (llama-3.3-70b-versatile,
# llama-3.1-8b-instant) were shut down by Groq on 2026-08-16 and are auto-ignored.
GROQ_MODEL=
